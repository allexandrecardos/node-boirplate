{
	"compilerOptions": {
		"baseUrl": "./src",
		"target": "ESNext",
		"module": "CommonJS",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
	},
	"include": ["src/**/*", "src/@types/enviroment.d.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"src/__tests__",
		"src/__docs__"
	]
}
